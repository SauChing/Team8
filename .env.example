# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (Local, AI Studio, and Vercel)
# ==============================================================================

# --- AI Studio & General Keys ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
# On Vercel: Set under Project Settings > Environment Variables.
# In AI Studio: Automatically injected from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this app is hosted (e.g., https://team8.vercel.app).
# On Vercel: If omitted, the app automatically falls back to VERCEL_PROJECT_PRODUCTION_URL
# or VERCEL_URL provided by Vercel system environments.
APP_URL="MY_APP_URL"

# --- Google Maps / Places API ---
# GOOGLE_MAPS_API_KEY: Optional. Used on the server for Google Places API queries (Place Search & Place Details).
# On Vercel: Configure in Project Settings > Environment Variables.
# Accepts GOOGLE_MAPS_API_KEY, GOOGLE_PLACES_API_KEY, or VITE_GOOGLE_MAPS_API_KEY.
# When omitted, the app smoothly uses the curated rich Singapore foodie dataset.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# --- Singapore OneMap API ---
# ONEMAP_API_KEY: OneMap token required for Geocode / Search API.
# Passed in Authorization header to:
# https://www.onemap.gov.sg/api/common/elastic/search?searchVal=...&returnGeom=Y&getAddrDetails=Y&pageNum=1
ONEMAP_API_KEY="YOUR_ONEMAP_API_KEY"

# ==============================================================================
# VERCEL SYSTEM ENVIRONMENT VARIABLES (Provided automatically by Vercel)
# Do NOT hardcode these in production; Vercel injects them at build/runtime.
# ==============================================================================
# VERCEL="1"
# VERCEL_ENV="production" # "production" | "preview" | "development"
# VERCEL_URL="team8-sauching.vercel.app"
# VERCEL_PROJECT_PRODUCTION_URL="team8.vercel.app"
# VERCEL_REGION="sin1"

